   "source": [
    "#preparing the train and val sets:\n",
    "\n",
    "FEATURE_NAMES = list(X_train.columns)\n",
    "\n",
    "X_train_array = X_train.to_numpy()\n",
    "y_train_array = y_train.astype(str).to_numpy()\n",
