   "source": [
    "def pass_roc_plot(df, model_name):\n",
    "\n",
    "    plt.figure(figsize=(8, 5))\n",
    "\n",
    "    plt.plot(\n",
    "        df[\"pass\"],\n",
    "        df[\"roc_auc\"],\n",
    "        marker=\"o\",\n",
    "    )\n",
    "    \n",
    "    plt.xlabel(\"Number of complete training passes\")\n",
    "    plt.ylabel(\"Validation ROC-AUC\")\n",
    "    plt.title(f\"{model_name}: ROC-AUC vs Training Passes\")\n",
    "    plt.xticks(CHECKPOINTS)\n",
    "    plt.grid(alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    "
   ]
  },
